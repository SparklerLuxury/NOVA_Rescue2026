<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila 1: Título y Etiqueta de Capacidad -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvNombreRefugio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvCapacidad"
                android:layout_marginEnd="8dp"
                android:text="Hospital General"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/tvCapacidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="45% Lleno"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_rounded_dark"
                android:textColor="#FFFFFF"/>
        </RelativeLayout>

        <!-- Fila 2: Tipo de Centro (Ej: Centro de Salud) -->
        <TextView
            android:id="@+id/tvTipoCentro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏥 Centro de Salud"
            android:textSize="12sp"
            android:textColor="#D15CE3"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Fila 3: Dirección y Distancia -->
        <TextView
            android:id="@+id/tvDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Av. Principal, Sector Centro"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="12dp"/>

        <!-- Botón de Trazar Ruta -->
        <Button
            android:id="@+id/btnIrAlLugar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="📍 VER CÓMO LLEGAR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#F3F4F6"
            android:textColor="#374151"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>